# Copy to .env.local and fill in. All variables are validated in lib/env.ts.

# App
APP_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth.js (generate AUTH_SECRET with: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=you@example.com
# true = new sign-ups land on the waitlist
WAITLIST_MODE=false

# Upstash Redis + QStash
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI + integrations
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=
SUPERMEMORY_API_KEY=
# Optional: transcribes Telegram voice messages (console.groq.com). Leave empty to turn voice off.
GROQ_API_KEY=

# Telegram (webhook secret: A-Z a-z 0-9 _ - only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
